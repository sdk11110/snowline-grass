      "html": "<label class=\"ds-field\">天气<select><option>晴天</option><option>降雪</option></select></label>",
      "css": ".ds-field{display:block;font:14px 'Patrick Hand',system-ui,sans-serif;color:#25343c}.ds-field select{display:block;width:100%;margin-top:7px;padding:6px 8px;font:15px 'Patrick Hand',system-ui,sans-serif;color:inherit;background:#fffdf8;border:1px solid #94a09d;border-radius:2px}.ds-field select:focus-visible{outline:3px solid #286788;outline-offset:3px}.ds-field select:disabled{opacity:.45;cursor:wait}"
    },
    {
      "name": "Category navigation",
      "kind": "nav",
      "description": "Five categories with a selected paper tab.",
      "html": "<nav class=\"ds-tabs\"><button aria-selected=\"true\">世界</button><button>操控</button><button>人物</button><button>画面</button><button>工程</button></nav>",
      "css": ".ds-tabs{display:flex;padding:0 9px;background:#eceee5;border-block:1px solid #a9b3b1}.ds-tabs button{flex:1;border:0;background:transparent;padding:9px 3px;font:14px 'Patrick Hand',system-ui,sans-serif;color:#25343c;cursor:pointer}.ds-tabs button[aria-selected=true]{background:#faf7ef;box-shadow:inset 0 -3px var(--lab-accent,#dcb847)}.ds-tabs button:hover{background:#f5f1e6}.ds-tabs button:focus-visible{outline:3px solid #286788;outline-offset:3px}"
    },
    {
      "name": "Paper panel",
      "kind": "custom",
      "description": "A compact scene-preserving settings container.",
      "html": "<section class=\"ds-panel\"><h2>漫游工坊</h2><p>让每一次出发，都有自己的节奏。</p></section>",
      "css": ".ds-panel{width:318px;max-width:calc(100vw - 20px);border:2px solid #25343c;border-radius:3px;background:#faf7ef;color:#25343c;box-shadow:0 8px 28px #14232c30;font:16px/1.4 'Patrick Hand',system-ui,sans-serif;padding:16px 17px 12px}.ds-panel h2{font-size:25px;font-weight:400;line-height:1.2;margin:0 0 4px}.ds-panel p{font-size:13px;color:#576a70;margin:0}"
    },
    {
      "name": "Destination selector",
      "kind": "nav",
      "description": "Three continuous destination rows; route color and pressed state identify the selected scene.",
      "html": "<nav class=\"ds-destinations\" aria-label=\"选择目的地\"><button aria-pressed=\"true\"><span>雪岭 <small>雪山滑行</small></span><small>高山 · 林间雪道</small></button><button aria-pressed=\"false\"><span>青岚 <small>草场漫游</small></span><small>草坡 · 山地滑行</small></button><button aria-pressed=\"false\"><span>潮汐 <small>海上冲浪</small></span><small>海湾 · 自由冲浪</small></button></nav>",
      "css": ".ds-destinations{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid #49635766;color:#263e35;background:var(--roam-paper,#f0eee3);font-family:\"Patrick Hand\",\"KaiTi\",\"STKaiti\",serif}.ds-destinations button{display:grid;gap:8px;min-height:108px;padding:22px 24px 18px;border:0;border-inline-end:1px solid #49635740;background:transparent;color:inherit;font:inherit;text-align:left;cursor:pointer;transition:background .18s}.ds-destinations button:last-child{border-inline-end:0}.ds-destinations span{font-size:25px;letter-spacing:.08em}.ds-destinations small{font-size:12px;color:#53685d;letter-spacing:.06em}.ds-destinations span small{margin-left:16px;font-size:13px;letter-spacing:0}.ds-destinations button[aria-pressed=true]{background:#faf8ed90;box-shadow:inset 0 -3px var(--roam-route,#c25d38)}.ds-destinations button:hover{background:#faf8ed}.ds-destinations button:focus-visible{outline:3px solid #b85b32;outline-offset:6px}@media(max-width:760px){.ds-destinations{grid-template-columns:1fr}.ds-destinations button{min-height:64px;padding:10px 11px;border-inline-end:0;border-block-end:1px solid #49635740}.ds-destinations span{font-size:22px}}@media(prefers-reduced-motion:reduce){.ds-destinations button{transition:none}}"
