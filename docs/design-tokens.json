      "css": ".ds-depart{display:flex;align-items:center;justify-content:space-between;gap:35px;min-height:56px;min-width:245px;padding:10px 23px;border:1px solid #315044;background:#315044;color:#f7f3e6;font:18px \"Patrick Hand\",\"KaiTi\",\"STKaiti\",serif;cursor:pointer;transition:background .16s,border-color .16s}.ds-depart svg{width:32px;height:20px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}.ds-depart:hover:not(:disabled){background:#41634f;border-color:#41634f}.ds-depart:active:not(:disabled){background:#213d31}.ds-depart:disabled{background:#64756a;border-color:#64756a;color:#d3d9cc;cursor:wait}.ds-depart:focus-visible{outline:3px solid #b85b32;outline-offset:6px}@media(prefers-reduced-motion:reduce){.ds-depart{transition:none}}"
    },
